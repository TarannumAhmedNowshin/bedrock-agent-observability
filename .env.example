# Copy to .env and fill in. No quotes, no spaces around "=".
# docker --env-file passes values literally, so quotes become part of the value.

# AWS (temporary credentials have a session token; long-lived keys don't)
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Model (Nova Lite works without a Bedrock access form: us.amazon.nova-lite-v1:0)
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Which step of the agent to run: 1, 2 or 3
AGENT_STEP=3

# Bronto (step 3+): API key for the MCP server. US accounts: https://mcp.us.bronto.io/mcp
BRONTO_API_KEY=
# BRONTO_MCP_URL=https://mcp.eu.bronto.io/mcp
